    <script>
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = '#334155';

        const ctxResource = document.getElementById('resourceChart').getContext('2d');
        const resourceChart = new Chart(ctxResource, {
            type: 'bar',
            data: {
                labels: ['CPU Usage', 'RAM Usage'],
                datasets: [{
                    label: 'Usage (%)',
                    data: [38, 62],
                    backgroundColor: ['#38bdf8', '#f59e0b'],
                    borderRadius: 8,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true, max: 100 } },
                plugins: { legend: { display: false } }
            }
        });

        const ctxDisk = document.getElementById('diskChart').getContext('2d');
        const diskChart = new Chart(ctxDisk, {
            type: 'doughnut',
            data: {
                labels: ['Used Space', 'Free Space'],
                datasets: [{
                    data: [35, 65],
                    backgroundColor: ['#ef4444', '#22c55e'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        const API_URL = "http://localhost:5000/api/monitoring-data";

        async function fetchMonitoringData() {
            try {
                const res = await fetch(API_URL);
                if (!res.ok) return;
                const data = await res.json();

                if(data.server_status) document.getElementById('server-status').innerText = data.server_status;
                if(data.ip_address) document.getElementById('ip-address').innerText = data.ip_address;
                if(data.uptime) document.getElementById('uptime').innerText = data.uptime;
                if(data.security_warnings !== undefined) document.getElementById('security-alerts').innerText = data.security_warnings + " Alerts";

                if(data.cpu_usage !== undefined && data.ram_usage !== undefined) {
                    resourceChart.data.datasets[0].data = [data.cpu_usage, data.ram_usage];
                    resourceChart.update();
                }

                if(data.disk_used !== undefined && data.disk_free !== undefined) {
                    diskChart.data.datasets[0].data = [data.disk_used, data.disk_free];
                    diskChart.update();
                }
            } catch (err) {
            }
        }

        setInterval(fetchMonitoringData, 5000);
    </script>
