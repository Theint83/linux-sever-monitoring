    <script>
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.borderColor = '#334155';

        const ctxResource = document.getElementById('resourceChart').getContext('2d');
        const resourceChart = new Chart(ctxResource, {
            type: 'bar',
            data: {
                labels: ['CPU Usage', 'RAM Usage'],
                datasets: [{
                    label: 'Usage (%)',
                    data: [38, 62],
                    backgroundColor: ['#38bdf8', '#f59e0b'],
                    borderRadius: 8,
                    barThickness: 40
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true, max: 100 } },
                plugins: { legend: { display: false } }
            }
        });

        const ctxDisk = document.getElementById('diskChart').getContext('2d');
        const diskChart = new Chart(ctxDisk, {
            type: 'doughnut',
            data: {
                labels: ['Used Space', 'Free Space'],
                datasets: [{
                    data: [35, 65],
                    backgroundColor: ['#ef4444', '#22c55e'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        const API_URL = "http://127.0.0.1:5000/api/monitoring-data";

        async function fetchMonitoringData() {
            try {
                const res = await fetch(API_URL);
                if (!res.ok) return;
                const data = await res.json();

                if(document.getElementById('server-status')) document.getElementById('server-status').innerText = data.server_status;
                if(document.getElementById('ip-address')) document.getElementById('ip-address').innerText=data.ip_address;
                if(document.getElementById('uptime')) document.getElementById('uptime').innerText = data.uptime;
                if(document.getElementById('security-alerts')) document.getElementById('security-alerts').innerText = data.security_warnings ;

                if(data.cpu_usage !== undefined && data.ram_usage !== undefined) {
                    resourceChart.data.datasets[0].data = [data.cpu_usage, data.ram_usage];
                    resourceChart.update();
                }

                if(data.disk_used !== undefined && data.disk_free !== undefined) {
                    diskChart.data.datasets[0].data = [data.disk_used, data.disk_free];
                    diskChart.update();
                }
	if (data.logs && Array.isArray(data.logs)){
	const tableBody =document.getElementById('logs-table-body');
	tableBody.innerHTML = ' ';
	let alertCount =0;
	data.logs.forEach(log=> {
	const isSecurityAlert=log.log_type ==='Security' || log.status_code >= 400;
	if (isSecurityAlert) {
	alertCount++;
	}
	const logTypeBadge = isSecurityAlert ? 'bg-danger' : 'bg-primary';
	const statusBadge = log.status_code >= 400 ? 'bg-warning text-dark' : 'bg-success';
	const row=`<tr>
		<td>${log.timestamp}</td>
		<td><span class="badge ${logTypeBadge}">${log.log_type}</span></td>
		<td><span class="badge ${statusBadge}">${log.status_code}</span></td>
		<td>${log.activity_details}</td>
		</tr>
	`;
	tableBody.insertAdjacentHTML('beforeend',row);
});
document.getElementById('security-alerts').innerText = alertCount + "Alerts";
}else if (data.security_warnings !== undefined){
	document.getElementById('security-alerts').innerText=data.security_warnings+"Alerts";
}
            } catch (err) {
	console.error("error occurs",err);
            }
        }
fetchMonitoringData();
setInterval(fetchMonitoringData,5000);
       
    </script>
</body>
