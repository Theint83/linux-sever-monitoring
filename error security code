#!/usr/bin/env python3
"""
Member 5: Error & Security Monitoring Script
Parses Apache logs to detect HTTP error codes, repeated failed requests, 
and suspicious activities, then generates security warnings.
"""

import re
from collections import Counter, defaultdict
from datetime import datetime

# Sample parser for demonstration / integration with Member 4's log module
APACHE_LOG_PATTERN = re.compile(
    r'(?P<ip>\S+) \S+ \S+ \[(?P<time>[^\]]+)\] "(?P<method>\S+) (?P<url>\S+) (?P<protocol>[^"]+)" (?P<status>\d+) (?P<size>\S+)'
)

class SecurityMonitor:
    def __init__(self, log_file_path="/var/log/apache2/access.log", failure_threshold=10):
        self.log_file_path = log_file_path
        self.failure_threshold = failure_threshold
        self.failed_requests_per_ip = defaultdict(int)
        self.error_code_counts = Counter()
        self.security_warnings = []

    def analyze_logs(self):
        """Simulates or reads log lines and flags suspicious patterns."""
        # For testing/demo purposes without a live file, we can provide a dummy stream or read file safely.
        try:
            with open(self.log_file_path, 'r') as file:
                for line in file:
                    self._process_line(line.strip())
        except FileNotFoundError:
            print(f"[Warning] Log file {self.log_file_path} not found. Running with sample analysis simulation.")
            self._run_simulation()

    def _process_line(self, line):
        match = APACHE_LOG_PATTERN.match(line)
        if match:
            data = match.groupdict()
            ip = data['ip']
            status = int(data['status'])
            
            # Track HTTP error codes (4xx, 5xx)
            if status >= 400:
                self.error_code_counts[status] += 1
                self.failed_requests_per_ip[ip] += 1

    def _run_simulation(self):
        """Simulate sample log parsing for initial testing."""
        sample_logs = [
            '192.168.1.50 - - [08/Sep/2026:01:10:00 +0630] "GET /admin HTTP/1.1" 403 502',
            '192.168.1.50 - - [08/Sep/2026:01:10:01 +0630] "GET /wp-login.php HTTP/1.1" 404 430',
            '192.168.1.50 - - [08/Sep/2026:01:10:02 +0630] "POST /login HTTP/1.1" 401 320',
            '10.0.0.15 - - [08/Sep/2026:01:10:05 +0630] "GET /index.html HTTP/1.1" 200 1230',
        ]
        # Simulate repeated failures from a malicious IP
        for _ in range(12):
            sample_logs.append('203.0.113.5 - - [08/Sep/2026:01:10:10 +0630] "GET /config.env HTTP/1.1" 404 196')

        for line in sample_logs:
            self._process_line(line)

    def evaluate_threats(self):
        """Detects repeated failed requests and generates security warnings."""
        for ip, count in self.failed_requests_per_ip.items():
            if count >= self.failure_threshold:
                warning_msg = f"[SECURITY ALERT] High rate of failed requests detected from IP {ip}: {count} failures."
                self.security_warnings.append({
                    "timestamp": datetime.now().isoformat(),
                    "ip": ip,
                    "failure_count": count,
                    "severity": "HIGH",
                    "message": warning_msg
                })
        return self.security_warnings

if __name__ == "__main__":
    monitor = SecurityMonitor(failure_threshold=5)
    monitor.analyze_logs()
    warnings = monitor.evaluate_threats()
    
    print("=== Security & Error Monitoring Report ==\n")
    print("HTTP Error Code Breakdown:", dict(monitor.error_code_counts))
    print("\nGenerated Security Warnings:")
    for w in warnings:
        print(w["message"])
